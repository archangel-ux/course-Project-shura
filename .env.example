# Copy to .env for local development. On a hosting platform set these as environment variables.

SUPABASE_URL=https://vnbpscrkqabvubtpbkwm.supabase.co
# Publishable key — safe for the browser/server; data is protected by row level security.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Bi56kgNHroTw8YkahDU4Lw_iohatDsO

# Public address of the site, used in email links (confirm sign-up, reset password).
SITE_URL=http://localhost:5000

# Long random string that signs session cookies. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

APP_TIMEZONE=Asia/Almaty

# Low-stock notifications (see README → «Уведомления»). Never commit real values.
TELEGRAM_BOT_TOKEN=
# Copy from the database: select value from qoima_private.settings where key = 'cron_secret';
CRON_SECRET=

# Optional email digest / invitations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
